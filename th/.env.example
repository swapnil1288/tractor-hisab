# Copy to .env (never commit .env). All values below are examples.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/tractor_hisab
NODE_ENV=production
PORT=3000
# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me
# Optional: if set, new owner accounts need this code to register
OWNER_SETUP_CODE=
# Farmer OTP: disabled | msg91   (dev is refused when NODE_ENV=production)
OTP_PROVIDER=disabled
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Path to Chromium for PDF rendering
CHROMIUM_PATH=/usr/bin/chromium
# PGSSL=require   # for managed Postgres that needs TLS
